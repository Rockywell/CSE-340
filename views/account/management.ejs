<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <%- messages() %>

            <% if (loggedin) { %>

                <!-- Greeting for all account types -->
                <h2>Welcome <%= accountData.account_firstname %>
                </h2>

                <!-- Update Account Information link (for all logged-in users) -->
                <p>
                    You're logged in.<br>
                    <a href="/account/update">
                        Update Account Information
                    </a>
                </p>

                <% if (accountData.account_type==="Employee" || accountData.account_type==="Admin" ) { %>
                    <!-- Inventory Management: ONLY for Employee or Admin -->
                    <h3>Inventory Management</h3>
                    <p>
                        <a href="/inv/">
                            Manage Inventory
                        </a>
                    </p>

                    <h3>User Role Management</h3>

                    <p>Select a user from the list</p>
                    <div class="controls">
                        <%- accountSelect %>
                            <a class="button" id="manageRoleLink"
                                href="/account/update/<%= accountData.account_id %>/role">
                                Mangage Role
                            </a>
                    </div>
                    <% } %>

                        <% } %>


                            <script src="/js/account-management.js"></script>